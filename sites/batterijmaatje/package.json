{
  "name": "batterijmaatje",
  "version": "1.0.0",
  "private": true,
  "description": "Statische vergelijkingssite voor thuisbatterijen. Dit bestand bestaat alleen voor de serverloze functie achter het contactformulier; de site zelf heeft geen build-stap.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "genereer": "node scripts/genereer-batterijpaginas.mjs",
    "keuzehulp": "node scripts/keuzehulp-spreiding.mjs",
    "prijzen": "node scripts/update-prices.mjs",
    "nieuwe-modellen": "node scripts/nieuwe-modellen.mjs",
    "nieuwe-modellen:proef": "node scripts/nieuwe-modellen.mjs --proef",
    "capaciteit": "node scripts/capaciteit-status.mjs",
    "vermogens": "node scripts/vermogen-verkennen.mjs",
    "links": "node scripts/controleer-links.mjs",
    "links:intern": "node scripts/controleer-links.mjs --intern",
    "meet": "node scripts/meet-site.mjs",
    "meet:vergelijk": "node scripts/meet-site.mjs --vergelijk",
    "beeld:voor": "node scripts/schermafdrukken.mjs --voor",
    "beeld:na": "node scripts/schermafdrukken.mjs --na",
    "beeld:verschil": "node scripts/schermafdrukken.mjs --verschil",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "sharp": "^0.33.5"
  }
}
